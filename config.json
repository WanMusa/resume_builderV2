{
  "providers": {
    "copilot_cli": {
      "auth": "cli"
    },
    "openai": {
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.openai.com/v1"
    },
    "gemini": {
      "api_key_env": "GEMINI_API_KEY",
      "json_mode": true
    },
    "anthropic": {
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  },
  "stages": {
    "extract": {
      "provider": "gemini",
      "model": "gemini-3.1-pro-preview"
    },
    "generate_resume": {
      "provider": "gemini",
      "model": "gemini-3.1-pro-preview"
    },
    "generate_cover_letter": {
      "provider": "gemini",
      "model": "gemini-3.1-pro-preview"
    }
  }
}