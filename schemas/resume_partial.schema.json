{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/resume_partial.schema.json",
  "title": "Resume Partial",
  "type": "object",
  "required": [
    "basics",
    "summary",
    "skills",
    "experience",
    "education",
    "projects"
  ],
  "additionalProperties": false,
  "properties": {
    "basics": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" },
        "portfolio": { "type": "string" }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "experience": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["title", "company", "startDate", "highlights"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "location": { "type": "string" },
          "startDate": { "type": "string", "minLength": 1 },
          "endDate": { "type": "string" },
          "current": { "type": "boolean", "default": false },
          "highlights": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        }
      }
    },
    "education": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["institution", "area", "studyType"],
        "additionalProperties": false,
        "properties": {
          "institution": { "type": "string", "minLength": 1 },
          "area": { "type": "string", "minLength": 1 },
          "studyType": { "type": "string", "minLength": 1 },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "score": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "highlights"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "techStack": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "keywords_matched": {
      "type": "array",
      "default": [],
      "items": { "type": "string" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string" },
        "generated_at": { "type": "string" },
        "model": { "type": "string" }
      }
    }
  }
}