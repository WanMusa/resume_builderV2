{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/resume_partial.schema.json",
  "title": "Resume Partial",
  "type": "object",
  "required": ["target_role_tags", "career_profile", "areas_of_expertise", "professional_experience"],
  "additionalProperties": false,
  "properties": {
    "target_role_tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "career_profile": {
      "type": "string",
      "minLength": 1
    },
    "areas_of_expertise": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "description"],
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "professional_experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "company", "tailored_summary", "tailored_achievements"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "company": { "type": "string", "minLength": 1 },
          "period": { "type": "string" },
          "tailored_summary": { "type": "string", "minLength": 1 },
          "tailored_achievements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["highlight", "detail"],
              "additionalProperties": false,
              "properties": {
                "highlight": { "type": "string", "minLength": 1 },
                "detail": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "ats_alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matched_keywords": { "type": "array", "items": { "type": "string" }, "default": [] },
        "missing_keywords": { "type": "array", "items": { "type": "string" }, "default": [] },
        "coverage_estimate": { "type": "number" }
      }
    },
    "evidence_used": {
      "type": "array",
      "default": [],
      "items": { "type": "string" }
    }
  }
}
