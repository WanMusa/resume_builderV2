{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/cover_letter.schema.json",
  "title": "Cover Letter",
  "type": "object",
  "required": ["poster_type", "salutation", "opening_paragraph", "body_paragraph_1", "body_paragraph_2", "closing_paragraph", "sign_off"],
  "additionalProperties": false,
  "properties": {
    "poster_type": {
      "type": "string",
      "enum": ["direct", "recruiter", "unknown"]
    },
    "salutation": {
      "type": "string",
      "minLength": 1
    },
    "opening_paragraph": {
      "type": "string",
      "minLength": 1
    },
    "body_paragraph_1": {
      "type": "string",
      "minLength": 1
    },
    "body_paragraph_2": {
      "type": "string",
      "minLength": 1
    },
    "closing_paragraph": {
      "type": "string",
      "minLength": 1
    },
    "sign_off": {
      "type": "string",
      "minLength": 1
    },
    "company_name": {
      "type": "string"
    },
    "hiring_manager_name": {
      "type": "string"
    }
  }
}
